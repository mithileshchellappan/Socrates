// Signing, bundle IDs and the other values one machine's builds may set, for every target
// (project.yml's configFiles). These defaults let anyone build: no team, the Mac app signed to
// run locally (ad-hoc), bundle IDs under com.example, no iCloud sync.
//
// To sign with your own team, copy Local.xcconfig.example to Local.xcconfig (not committed) and
// set your values there; it is included last, so its values win.

// Your Apple developer team ID (empty: none). iPhone device builds need one; a free personal team
// works. Simulator builds and the ad-hoc Mac build do not.
SOCRATES_TEAM =

// The bundle ID prefix: the app is $(BUNDLE_ID_PREFIX).socrates, its widget extension
// $(BUNDLE_ID_PREFIX).socrates.widgets, its document types $(BUNDLE_ID_PREFIX).socrates.lecture
// and .lecture-bundle.
BUNDLE_ID_PREFIX = com.example

// The Mac app's signing identity and style. "-" with Automatic signs to run locally; macOS may
// ask for permissions again after a rebuild because the signature changes every build.
SOCRATES_MAC_SIGN_IDENTITY = -
SOCRATES_MAC_SIGN_STYLE = Automatic
// A manually signed Mac app's provisioning profile (its name), when it needs one: a Developer ID
// build with iCloud. Empty: none (automatic signing finds its own).
SOCRATES_MAC_PROFILE =

// iCloud sync of the library between the Mac and the iPhone: YES signs both apps with the iCloud
// (CloudKit) and push entitlements for the container iCloud.$(BUNDLE_ID_PREFIX).socrates and
// names it in their Info.plist (the app syncs only when both are there). Needs a team; build once
// with -allowProvisioningUpdates and Xcode registers the App ID, the container and the profiles.
// On the Mac it needs an Apple Development identity with Automatic signing (or a Developer ID
// profile in SOCRATES_MAC_PROFILE). NO: no entitlement, no container, the app never touches
// iCloud. Simulator builds never sync.
SOCRATES_ICLOUD = NO

SOCRATES_CLOUDKIT_CONTAINER_YES = iCloud.$(BUNDLE_ID_PREFIX).socrates
SOCRATES_CLOUDKIT_CONTAINER = $(SOCRATES_CLOUDKIT_CONTAINER_$(SOCRATES_ICLOUD))
SOCRATES_SYNC_CONTAINER = $(SOCRATES_CLOUDKIT_CONTAINER)
SOCRATES_SYNC_CONTAINER[sdk=iphonesimulator*] =
SOCRATES_MAC_ENTITLEMENTS_NO = App/macOS/Socrates.entitlements
SOCRATES_MAC_ENTITLEMENTS_YES = App/macOS/Socrates-iCloud.entitlements
SOCRATES_MAC_ENTITLEMENTS = $(SOCRATES_MAC_ENTITLEMENTS_$(SOCRATES_ICLOUD))
SOCRATES_IOS_ENTITLEMENTS_YES = App/iOS/Socrates-iCloud.entitlements
SOCRATES_IOS_ENTITLEMENTS = $(SOCRATES_IOS_ENTITLEMENTS_$(SOCRATES_ICLOUD))

// The bundle ID an earlier build of this app had on this machine, when it was different (the app
// was called Study Portal). The Mac app then takes over what that build left once: the library
// folder, its preferences and its Keychain items (docs/decisions.md). Empty: none.
SOCRATES_LEGACY_BUNDLE_ID =

// A university profile as one line of JSON (`UniversityProfile`'s keys; no "//" in it), which a
// library that has courses but no profile takes once when it opens: for a library set up by a
// build that had its university built in. Empty: none (a student sets their profile by telling
// the agent).
SOCRATES_UNIVERSITY_PROFILE =

#include? "Local.xcconfig"
